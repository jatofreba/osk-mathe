  "task_html": "<div class='task-block task-blue'><div class='task-block-label'>Ereignis + Gegenereignis = 100 %</div><p style='font-size:14px;line-height:1.7;margin:0;'>Das <strong>Gegenereignis</strong> sind alle Ergebnisse, die <strong>nicht</strong> zum Ereignis geh&ouml;ren. Zusammen ergeben Ereignis und Gegenereignis immer 100&nbsp;%.</p></div><div class='task-block task-green' style='margin-top:12px;'><div class='task-block-label'>Beispiel</div><p style='font-size:14px;line-height:1.7;margin:0;'>P(W&uuml;rfel zeigt 6) &asymp; 16,7&nbsp;%<br>P(W&uuml;rfel zeigt <strong>keine</strong> 6) = 100&nbsp;% &minus; 16,7&nbsp;% = <strong>83,3&nbsp;%</strong></p></div><div class='task-block task-orange' style='margin-top:12px;'><div class='task-block-label'>Jetzt du</div><div class='tbl-wrap'><table><thead><tr><th style='background:#2563eb;'>Situation</th><th style='background:#2563eb;'>P(Ereignis) (%)</th><th style='background:#2563eb;'>P(Gegenereignis) (%)</th></tr></thead><tbody><tr><td class='row-label'>allgemein</td><td class='row-label'>20</td><td><input class='cell-input' data-ans='80' placeholder='?'></td></tr><tr><td class='row-label'>allgemein</td><td class='row-label'>45</td><td><input class='cell-input' data-ans='55' placeholder='?'></td></tr><tr><td class='row-label'>Lostopf: Gewinn</td><td class='row-label'>30</td><td><input class='cell-input' data-ans='70' placeholder='?'></td></tr><tr><td class='row-label'>Wettervorhersage: kein Regen</td><td class='row-label'>65</td><td><input class='cell-input' data-ans='35' placeholder='?'></td></tr><tr><td class='row-label'>rückwärts gedacht</td><td><input class='cell-input' data-ans='10' placeholder='?'></td><td class='row-label'>90</td></tr></tbody></table></div></div><div class='check-bar'><button class='btn-check' onclick='checkStation(9)'>&#x2713; &Uuml;berpr&uuml;fen</button><button class='btn-reset' onclick='resetStation(9)'>&#x21BA; Zur&uuml;cksetzen</button><span class='check-result' id='check-result-9'></span></div>",
  "sol_html": "<div style='font-size:14px;line-height:1.8;'>100&nbsp;% &minus; 20&nbsp;% = <strong>80&nbsp;%</strong><br>100&nbsp;% &minus; 45&nbsp;% = <strong>55&nbsp;%</strong><br>Lostopf: 100&nbsp;% &minus; 30&nbsp;% = <strong>70&nbsp;%</strong> Niete<br>Wetter: 100&nbsp;% &minus; 65&nbsp;% = <strong>35&nbsp;%</strong> Regen<br>R&uuml;ckw&auml;rts: 100&nbsp;% &minus; 90&nbsp;% = <strong>10&nbsp;%</strong></div>"
