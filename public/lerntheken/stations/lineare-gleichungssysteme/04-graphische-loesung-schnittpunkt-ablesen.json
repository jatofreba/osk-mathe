  "hasSol": true,
  "geogebra": {
    "appName": "classic",
    "perspective": "G",
    "height": 400,
    "showToolBar": false,
    "showAlgebraInput": false,
    "enableShiftDragZoom": true,
    "enableRightClick": false,
    "commands": [
      "tarifA(x) = 0.4*x + 6",
      "tarifB(x) = 0.2*x + 10",
      "S = Intersect(tarifA, tarifB)",
      "SetColor(tarifA, 37, 99, 235)",
      "SetColor(tarifB, 22, 163, 74)",
      "SetColor(S, 217, 119, 6)",
      "SetPointSize(S, 6)",
      "SetLineThickness(tarifA, 4)",
      "SetLineThickness(tarifB, 4)",
      "ShowLabel(S, false)",
      "SetCaption(tarifA, \"AKZENT\")",
      "SetLabelMode(tarifA, 3)",
      "SetCaption(tarifB, \"BASIS\")",
      "SetLabelMode(tarifB, 3)",
      "ZoomIn(-2, -1, 38, 22)"
    ]
  },
  "task_html": "<div style='background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:14px 18px;margin:10px 0;'><p style='font-size:14px;line-height:1.7;margin:0;'>Zwei Stromtarife im Vergleich: <strong style='color:#2563eb;'>AKZENT</strong> (blau) kostet 0,40 &euro; pro kWh + 6 &euro; Grundgeb&uuml;hr. <strong style='color:#16a34a;'>BASIS</strong> (gr&uuml;n) kostet 0,20 &euro; pro kWh + 10 &euro; Grundgeb&uuml;hr. Du kannst zoomen und verschieben.</p></div><div id='ggb-container' class='ggb-wrap'><p>&#x23F3; Lade interaktives Diagramm&hellip;</p></div><hr style='margin:16px 0;border:none;border-top:1px solid #ddd;'><p style='font-size:14px;font-weight:600;margin:8px 0;'>Aufgabe A &ndash; Kosten bei 10 kWh ablesen</p><p style='font-size:13px;margin:6px 0 10px;'>Lies aus dem Graphen ab: Was kostet jeder Tarif bei 10 kWh Verbrauch?</p><div style='display:flex;gap:16px;margin-bottom:4px;'><div style='flex:1;background:#eff6ff;border-radius:8px;padding:10px 14px;'><p style='margin:0 0 6px;font-size:13px;font-weight:600;color:#2563eb;'>AKZENT:</p><div style='display:flex;align-items:center;gap:6px;'><input class='cell-input' data-ans='10' placeholder='?'> <span style='font-size:13px;'>&euro;</span></div></div><div style='flex:1;background:#f0fdf4;border-radius:8px;padding:10px 14px;'><p style='margin:0 0 6px;font-size:13px;font-weight:600;color:#16a34a;'>BASIS:</p><div style='display:flex;align-items:center;gap:6px;'><input class='cell-input' data-ans='12' placeholder='?'> <span style='font-size:13px;'>&euro;</span></div></div></div><hr style='margin:16px 0;border:none;border-top:1px solid #ddd;'><p style='font-size:14px;font-weight:600;margin:8px 0;'>Aufgabe B &ndash; Schnittpunkt S bestimmen</p><p style='font-size:13px;margin:6px 0 10px;'>Lies die Koordinaten des Schnittpunkts S ab: Bei welchem Verbrauch sind beide Tarife gleich teuer?</p><div class='tbl-wrap'><table><thead><tr><th style='background:#d95f2b;'>x (kWh)</th><th style='background:#d95f2b;'>y (&euro;)</th></tr></thead><tbody><tr><td><input class='cell-input' data-ans='20' placeholder='?'></td><td><input class='cell-input' data-ans='14' placeholder='?'></td></tr></tbody></table></div><hr style='margin:16px 0;border:none;border-top:1px solid #ddd;'><p style='font-size:14px;font-weight:600;margin:8px 0;'>Aufgabe C &ndash; Weiterdenken</p><p style='font-size:13px;margin:6px 0 10px;'>Lies ab: Bei 30 kWh &ndash; um wie viele Euro ist BASIS g&uuml;nstiger als AKZENT?</p><div style='display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px;'><span style='font-size:13px;'>BASIS ist um</span> <input class='cell-input' data-ans='2' placeholder='?' style='width:60px;'> <span style='font-size:13px;'>&euro; g&uuml;nstiger.</span></div><div class='check-bar'><button class='btn-check' onclick='checkStation(4)'>&#x2713; &Uuml;berpr&uuml;fen</button><button class='btn-reset' onclick='resetStation(4)'>&#x21BA; Zur&uuml;cksetzen</button><span class='check-result' id='check-result-4'></span></div>",
  "sol_html": "<p style='font-size:14px;line-height:1.8;'><strong>Aufgabe A:</strong> Bei 10 kWh: AKZENT = <strong>10 &euro;</strong>, BASIS = <strong>12 &euro;</strong> &rarr; AKZENT ist g&uuml;nstiger.<br><br><strong>Aufgabe B:</strong> Schnittpunkt S = <strong>(20 | 14)</strong>. Bei 20 kWh sind beide Tarife gleich teuer (14 &euro;).<br><br><strong>Aufgabe C:</strong> Bei 30 kWh kostet AKZENT 18 &euro;, BASIS 16 &euro; &rarr; BASIS ist um <strong>2 &euro;</strong> g&uuml;nstiger.<br><br><strong>Fazit:</strong> Bis 20 kWh ist AKZENT g&uuml;nstiger. Ab 20 kWh lohnt sich BASIS.</p>",
  "mandatory": true
}
