  "task_html": "<div style='background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:10px;padding:14px 18px;margin:10px 0;'><p style='font-size:14px;line-height:1.7;margin:0;'>Ein Fitnessstudio bietet drei Mitgliedschaften an: <strong>Tarif A</strong> 15&euro; + 4&euro;/Trainingstag, <strong>Tarif B</strong> 30&euro; + 2&euro;/Trainingstag, <strong>Tarif C</strong> 50&euro; monatlich, alle Trainingstage kostenlos.</p></div><p style='font-size:14px;margin:12px 0 8px;'><strong>Aufgabe:</strong> Berechne die Kosten aller drei Tarife f&uuml;r 0, 5, 10 und 15 Trainingstage im Monat.</p><div class='tbl-wrap'><table><thead><tr><th style='background:#16a34a;'>Trainingstage</th><th style='background:#16a34a;'>0</th><th style='background:#16a34a;'>5</th><th style='background:#16a34a;'>10</th><th style='background:#16a34a;'>15</th></tr></thead><tbody><tr><td class='row-label'>A (15+4x)</td><td><input class='cell-input' data-ans='15' placeholder='?'></td><td><input class='cell-input' data-ans='35' placeholder='?'></td><td><input class='cell-input' data-ans='55' placeholder='?'></td><td><input class='cell-input' data-ans='75' placeholder='?'></td></tr><tr><td class='row-label'>B (30+2x)</td><td><input class='cell-input' data-ans='30' placeholder='?'></td><td><input class='cell-input' data-ans='40' placeholder='?'></td><td><input class='cell-input' data-ans='50' placeholder='?'></td><td><input class='cell-input' data-ans='60' placeholder='?'></td></tr><tr><td class='row-label'>C (50)</td><td><input class='cell-input' data-ans='50' placeholder='?'></td><td><input class='cell-input' data-ans='50' placeholder='?'></td><td><input class='cell-input' data-ans='50' placeholder='?'></td><td><input class='cell-input' data-ans='50' placeholder='?'></td></tr></tbody></table></div><div class='check-bar'><button class='btn-check' onclick='checkStation(16)'>&#x2713; &Uuml;berpr&uuml;fen</button><button class='btn-reset' onclick='resetStation(16)'>&#x21BA; Zur&uuml;cksetzen</button><span class='check-result' id='check-result-16'></span></div>",
  "sol_html": "<p style='font-size:14px;line-height:1.9;'>Bei wenigen Trainingstagen ist <strong>A</strong> am g&uuml;nstigsten, ab ca. 7&ndash;8 Tagen wird <strong>B</strong> besser, und bei sehr vielen Trainingstagen (ab 10) ist <strong>C</strong> mindestens gleich gut wie B. Rechnerisch: A=B bei 15+4x=30+2x &rarr; x=7,5; B=C bei 30+2x=50 &rarr; x=10.</p>",
  "mandatory": true
}
