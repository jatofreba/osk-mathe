  "hasSol": true,
  "task_html": "<div style='background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:14px 18px;margin:10px 0;'><p style='font-size:14px;line-height:1.7;margin:0;'>Ein Elektrizit&auml;tsunternehmen bietet zwei Tarife an:</p></div><div class='tbl-wrap'><table><thead><tr><th style='background:#d95f2b;'>Tarif</th><th style='background:#d95f2b;'>Grundpreis</th><th style='background:#d95f2b;'>Preis je kWh</th></tr></thead><tbody><tr><td class='given'>AKZENT</td><td class='given'>6,00&euro;</td><td class='given'>0,32&euro;</td></tr><tr><td class='given'>BASIS</td><td class='given'>7,75&euro;</td><td class='given'>0,25&euro;</td></tr></tbody></table></div><p style='font-size:14px;margin:12px 0 8px;'><strong>Aufgabe:</strong> Stelle f&uuml;r x kWh Verbrauch je eine Kostengleichung y = m&middot;x+b auf. Trage die vier Werte ein:</p><div class='tbl-wrap'><table><thead><tr><th style='background:#d95f2b;'></th><th style='background:#d95f2b;'>m (Preis/kWh)</th><th style='background:#d95f2b;'>b (Grundpreis)</th></tr></thead><tbody><tr><td class='row-label'>AKZENT</td><td><input class='cell-input' data-ans='0.32' placeholder='?'></td><td><input class='cell-input' data-ans='6' placeholder='?'></td></tr><tr><td class='row-label'>BASIS</td><td><input class='cell-input' data-ans='0.25' placeholder='?'></td><td><input class='cell-input' data-ans='7.75' placeholder='?'></td></tr></tbody></table></div><div class='check-bar'><button class='btn-check' onclick='checkStation(2)'>&#x2713; &Uuml;berpr&uuml;fen</button><button class='btn-reset' onclick='resetStation(2)'>&#x21BA; Zur&uuml;cksetzen</button><span class='check-result' id='check-result-2'></span></div>",
  "sol_html": "<p style='font-size:14px;line-height:1.8;'>(I) AKZENT: <strong>y = 0,32x + 6</strong><br>(II) BASIS: &nbsp;<strong>y = 0,25x + 7,75</strong><br>\"Gleich viel bezahlen\" bedeutet: beide y-Werte sind gleich &rarr; die beiden Gleichungen bilden zusammen ein <strong>Gleichungssystem</strong>.</p>",
  "mandatory": true
}
