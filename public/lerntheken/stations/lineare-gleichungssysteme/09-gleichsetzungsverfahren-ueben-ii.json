  "task_html": "<div style='background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:14px 18px;margin:10px 0;'><p style='font-size:14px;line-height:1.7;margin:0;'>L&ouml;se das Gleichungssystem mit dem Gleichsetzungsverfahren:</p></div><div style='text-align:center;font-family:monospace;font-weight:700;margin:8px 0;'>(I) y=&minus;x+6 &nbsp;&nbsp; (II) y=2x&minus;3</div><div style='font-size:13px;'>x = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='3' placeholder='?'> &nbsp;&nbsp; y = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='3' placeholder='?'></div><div class='check-bar'><button class='btn-check' onclick='checkStation(9)'>&#x2713; &Uuml;berpr&uuml;fen</button><button class='btn-reset' onclick='resetStation(9)'>&#x21BA; Zur&uuml;cksetzen</button><span class='check-result' id='check-result-9'></span></div>",
  "sol_html": "<p style='font-size:14px;line-height:1.8;'>&minus;x+6=2x&minus;3 &rarr; 9=3x &rarr; <strong>x=3</strong><br>y=&minus;3+6=<strong>3</strong> &nbsp; Probe: 2&middot;3&minus;3=3 &check; &nbsp; L&ouml;sung: <strong>(3|3)</strong></p>",
