  "hasSol": true,
  "task_html": "<div style='background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:14px 18px;margin:10px 0;'><p style='font-size:14px;line-height:1.7;margin:0;'>Löse die Gleichungssysteme mit dem Gleichsetzungsverfahren. Rechne die Zwischenschritte auf einem Blatt Papier – hier trägst du nur x und y ein.</p></div><div style='background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:10px 14px;margin:10px 0 4px;'><p style='font-size:13px;font-weight:700;margin:0 0 2px;color:#1e3a8a;'>Aufgabe 1</p><p style='font-size:14px;line-height:1.7;margin:0;'>(I) y = &minus;x+6 &nbsp;&nbsp; (II) y = 2x&minus;3</p></div><div style='font-size:13px;padding:2px 0 8px;'>x = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='3' placeholder='?'> &nbsp;&nbsp; y = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='3' placeholder='?'></div><div style='background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:10px 14px;margin:10px 0 4px;'><p style='font-size:13px;font-weight:700;margin:0 0 2px;color:#1e3a8a;'>Aufgabe 2</p><p style='font-size:14px;line-height:1.7;margin:0;'>(I) y = 2x&minus;4 &nbsp;&nbsp; (II) y = &minus;x+8</p></div><div style='font-size:13px;padding:2px 0 8px;'>x = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='4' placeholder='?'> &nbsp;&nbsp; y = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='4' placeholder='?'></div><div style='background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:10px 14px;margin:10px 0 4px;'><p style='font-size:13px;font-weight:700;margin:0 0 2px;color:#1e3a8a;'>Aufgabe 3</p><p style='font-size:14px;line-height:1.7;margin:0;'>(I) y = x&minus;2 &nbsp;&nbsp; (II) y = &minus;2x+7</p></div><div style='font-size:13px;padding:2px 0 8px;'>x = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='3' placeholder='?'> &nbsp;&nbsp; y = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='1' placeholder='?'></div><div class='check-bar'><button class='btn-check' onclick='checkStation(9)'>&#x2713; Überprüfen</button><button class='btn-reset' onclick='resetStation(9)'>&#x21BA; Zurücksetzen</button><span class='check-result' id='check-result-9'></span></div>",
  "sol_html": "<p style='font-size:14px;line-height:1.9;'><strong>Aufgabe 1:</strong> &minus;x+6=2x&minus;3 &rarr; 9=3x &rarr; x=<strong>3</strong>, y=&minus;3+6=<strong>3</strong> &nbsp; Probe: 2&middot;3&minus;3=3 &check; &nbsp; Lösung: <strong>(3|3)</strong><br><strong>Aufgabe 2:</strong> 2x&minus;4=&minus;x+8 &rarr; 3x=12 &rarr; x=<strong>4</strong>, y=&minus;4+8=<strong>4</strong> &nbsp; Probe: 2&middot;4&minus;4=4 &check; &nbsp; Lösung: <strong>(4|4)</strong><br><strong>Aufgabe 3:</strong> x&minus;2=&minus;2x+7 &rarr; 3x=9 &rarr; x=<strong>3</strong>, y=3&minus;2=<strong>1</strong> &nbsp; Probe: &minus;2&middot;3+7=1 &check; &nbsp; Lösung: <strong>(3|1)</strong></p>",
  "mandatory": false
}
