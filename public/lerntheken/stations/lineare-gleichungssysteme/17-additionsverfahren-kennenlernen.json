  "hasSol": true,
  "task_html": "<div style='background:#f5f3ff;border:1.5px solid #ddd6fe;border-radius:10px;padding:14px 18px;margin:10px 0;'><p style='font-size:14px;line-height:1.7;margin:0;'>Ein drittes L&ouml;sungsverfahren ist das <strong>Additionsverfahren</strong>: Man addiert beide Gleichungen so, dass sich eine Variable weghebt.</p></div><div style='text-align:center;font-family:monospace;font-weight:700;margin:8px 0;'>(I) 3x+2y=16 &nbsp;&nbsp; (II) 3x&minus;2y=8</div><p style='font-size:13px;margin:8px 0;'>Addiere (I)+(II): das y f&auml;llt weg.</p><div style='font-size:13px;'>x = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='4' placeholder='?'> &nbsp;&nbsp; y = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='2' placeholder='?'></div><div class='check-bar'><button class='btn-check' onclick='checkStation(17)'>&#x2713; &Uuml;berpr&uuml;fen</button><button class='btn-reset' onclick='resetStation(17)'>&#x21BA; Zur&uuml;cksetzen</button><span class='check-result' id='check-result-17'></span></div>",
  "sol_html": "<p style='font-size:14px;line-height:1.8;'>(I)+(II): 6x=24 &rarr; <strong>x=4</strong><br>x in (I): 12+2y=16 &rarr; 2y=4 &rarr; <strong>y=2</strong> &nbsp; Probe (II): 12&minus;4=8 &check; &nbsp; L&ouml;sung: <strong>(4|2)</strong></p>",
  "mandatory": false
}
