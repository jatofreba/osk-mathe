  "hasSol": true,
  "task_html": "<div style='background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:14px 18px;margin:10px 0;'><p style='font-size:14px;line-height:1.7;margin:0;'>L&ouml;se das Gleichungssystem mit dem Gleichsetzungsverfahren:</p></div><div style='text-align:center;font-family:monospace;font-weight:700;margin:8px 0;'>(I) y=4x&minus;1 &nbsp;&nbsp; (II) y=x+5</div><div style='font-size:13px;'>x = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='2' placeholder='?'> &nbsp;&nbsp; y = <input class='cell-input' style='width:70px;display:inline-block;' data-ans='7' placeholder='?'></div><div class='check-bar'><button class='btn-check' onclick='checkStation(8)'>&#x2713; &Uuml;berpr&uuml;fen</button><button class='btn-reset' onclick='resetStation(8)'>&#x21BA; Zur&uuml;cksetzen</button><span class='check-result' id='check-result-8'></span></div>",
  "sol_html": "<p style='font-size:14px;line-height:1.8;'>4x&minus;1=x+5 &rarr; 3x=6 &rarr; <strong>x=2</strong><br>y=2+5=<strong>7</strong> &nbsp; Probe: 4&middot;2&minus;1=7 &check; &nbsp; L&ouml;sung: <strong>(2|7)</strong></p>",
  "mandatory": false
