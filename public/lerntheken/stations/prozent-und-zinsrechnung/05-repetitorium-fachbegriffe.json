{
  "id": 5,
  "title": "Repetitorium: Fachbegriffe der Kassen-Rechnung",
  "group": "Pflicht",
  "gc": "#d95f2b",
  "gbg": "#fff7f4",
  "gbr": "#fcd9c8",
  "hilfen": [1, 2, 6],
  "hasSol": true,
  "task_html": "<div class='task-block task-orange'><div class='task-block-label'>Was ihr bis hierher gelernt habt</div><p style='font-size:14px;line-height:1.7;margin:0;'>Bei der Klassenfahrt-Kasse geht es immer um dieselben Fragen: Wie viel ist das Ganze? Wie viel ist der Anteil? Wie viel Prozent sind das? Probiert die vier Aufgaben &ndash; sie mischen alles, was ihr schon kennt.</p></div><div class='task-block task-blue' style='margin-top:12px;'><div class='task-block-label'>1) Grundwert gesucht</div><p style='font-size:14px;margin:0 0 8px 0;'>40&nbsp;&euro; sind 20&nbsp;% von der ganzen Kasse. Wie viel &euro; sind insgesamt in der Kasse?</p><input class='cell-input' data-ans='200' placeholder='Wie viele €?'></div><div class='task-block task-green' style='margin-top:12px;'><div class='task-block-label'>2) Prozentwert gesucht</div><p style='font-size:14px;margin:0 0 8px 0;'>Wie viel &euro; sind 25&nbsp;% von 80&nbsp;&euro;?</p><input class='cell-input' data-ans='20' placeholder='Wie viele €?'></div><div class='task-block task-orange' style='margin-top:12px;'><div class='task-block-label'>3) Zinsen gesucht</div><p style='font-size:14px;margin:0 0 8px 0;'>Die Kasse legt 50&nbsp;&euro; zu 4&nbsp;% Zinssatz an. Wie viel &euro; Zinsen gibt es nach einem Jahr?</p><input class='cell-input' data-ans='2' placeholder='Wie viele €?'></div><div class='task-block task-blue' style='margin-top:12px;'><div class='task-block-label'>4) Zinssatz gesucht</div><p style='font-size:14px;margin:0 0 8px 0;'>Kapital 200&nbsp;&euro;, Zinsen nach einem Jahr 4&nbsp;&euro;. Wie hoch ist der Zinssatz?</p><input class='cell-input' data-ans='2' placeholder='Wie viel %?'></div><div class='check-bar'><button class='btn-check' onclick='checkStation(5)'>&#x2713; &Uuml;berpr&uuml;fen</button><button class='btn-reset' onclick='resetStation(5)'>&#x21BA; Zur&uuml;cksetzen</button><span class='check-result' id='check-result-5'></span></div>",
  "sol_html": "<div style='font-size:14px;line-height:1.8;'>1) Grundwert: 40&nbsp;&euro; : 20 &middot; 100 = <strong>200&nbsp;&euro;</strong><br>2) Prozentwert: 80&nbsp;&euro; : 100 &middot; 25 = <strong>20&nbsp;&euro;</strong><br>3) Zinsen: 50&nbsp;&euro; : 100 &middot; 4 = <strong>2&nbsp;&euro;</strong><br>4) Zinssatz: 4&nbsp;&euro; : 200 &middot; 100 = <strong>2&nbsp;%</strong></div>"
}
