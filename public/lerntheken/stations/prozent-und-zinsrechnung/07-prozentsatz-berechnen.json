  "task_html": "<a href='https://studyflix.de/mathematik/dreisatz-prozent-3037?topic_id=428' target='_blank' class='video-link-card' style='margin-bottom:16px;'><div class='video-link-icon'>&#x25B6;</div><div class='video-link-text'><div class='video-link-title'>Dreisatz bei der Prozentrechnung</div><div class='video-link-sub'>studyflix.de &middot; Erkl&auml;rvideo</div></div><div class='video-link-arrow'>&#x2197;</div></a><div class='task-block task-blue'><div class='task-block-label'>So findest du den Prozentsatz</div><p style='font-size:14px;line-height:1.9;margin:0;'>&#9312; Der ganze Einkauf ist der Grundwert = 100&nbsp;%.<br>&#9313; Grundwert : 100 = Wert f&uuml;r 1&nbsp;%.<br>&#9314; Rabatt-Betrag : Wert f&uuml;r 1&nbsp;% = wie viel Prozent.</p></div><div class='task-block task-green' style='margin-top:12px;'><div class='task-block-label'>Beispiel</div><p style='font-size:14px;line-height:1.7;margin:0;'>Der Einkauf f&uuml;r die Klassenfahrt kostet <strong>40&nbsp;&euro;</strong>. An der Kasse zieht die Verk&auml;uferin <strong>8&nbsp;&euro; Rabatt</strong> ab.<br>&#9312; 40&nbsp;&euro; = 100&nbsp;%<br>&#9313; 40&nbsp;&euro; : 100 = 0,40&nbsp;&euro; (1&nbsp;%)<br>&#9314; 8&nbsp;&euro; : 0,40&nbsp;&euro; = <strong>20&nbsp;%</strong> Rabatt</p></div><div class='task-block task-orange' style='margin-top:12px;'><div class='task-block-label'>Jetzt du &ndash; &Uuml;bung</div><p style='font-size:14px;margin:0 0 10px 0;'>Berechnet f&uuml;r jeden Einkauf den Prozentsatz des Rabatts.</p><div class='tbl-wrap'><table><thead><tr><th style='background:#2563eb;'>Einkauf (&euro;)</th><th style='background:#2563eb;'>Rabatt (&euro;)</th><th style='background:#2563eb;'>Prozentsatz (%)</th></tr></thead><tbody><tr><td class='row-label'>50</td><td class='row-label'>5</td><td><input class='cell-input' data-ans='10' placeholder='?'></td></tr><tr><td class='row-label'>80</td><td class='row-label'>20</td><td><input class='cell-input' data-ans='25' placeholder='?'></td></tr><tr><td class='row-label'>30</td><td class='row-label'>6</td><td><input class='cell-input' data-ans='20' placeholder='?'></td></tr></tbody></table></div></div><div class='check-bar'><button class='btn-check' onclick='checkStation(7)'>&#x2713; &Uuml;berpr&uuml;fen</button><button class='btn-reset' onclick='resetStation(7)'>&#x21BA; Zur&uuml;cksetzen</button><span class='check-result' id='check-result-7'></span></div>",
  "sol_html": "<div style='font-size:14px;line-height:1.8;'>50&nbsp;&euro; : 100 = 0,50&nbsp;&euro; (1&nbsp;%), dann 5&nbsp;&euro; : 0,50&nbsp;&euro; = <strong>10&nbsp;%</strong><br>80&nbsp;&euro; : 100 = 0,80&nbsp;&euro; (1&nbsp;%), dann 20&nbsp;&euro; : 0,80&nbsp;&euro; = <strong>25&nbsp;%</strong><br>30&nbsp;&euro; : 100 = 0,30&nbsp;&euro; (1&nbsp;%), dann 6&nbsp;&euro; : 0,30&nbsp;&euro; = <strong>20&nbsp;%</strong></div>"
}
